{
  "name": "check-me-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start  --dev-client",
    "ios": "expo start -c --ios",
    "web": "expo start -c --web",
    "prebuild:clean": "pnpm expo prebuild --clean",
    "prebuild": "pnpm expo prebuild",
    "android": "expo run:android --variant debugOptimized",
    "clean": "rm -rf .expo node_modules",
    "doctor": "npx expo-doctor@latest",
    "build:dev:android": "eas build --profile development --platform android",
    "build:preview:android": "eas build --profile preview --platform android",
    
    "build:prod:android": "eas build --profile production --platform android",
    "export:routes": "npx expo export --platform web --no-ssg",
    "deploy:routes": "eas deploy",
    "submit:android": "eas submit --platform android",
    "type-check": "tsc  --noemit",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\""
  },
